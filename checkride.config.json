{
  "checks": {
    "types": { "use": "tsc", "order": 1 },
    "lint": { "use": "oxlint", "order": 1 },
    "struct": { "use": "ast-grep", "order": 1 },
    "links": {
      "use": "links",
      "exclude": [".ridgeline", ".plumbbob", ".fascicle", ".vale"],
      "order": 1
    },
    "deps": {
      "command": "node",
      "args": ["scripts/check-deps.mjs"],
      "description": "core/engine production deps + engine optional peers invariant (constraints.md §7.2)",
      "order": 1
    },
    "exemplars": {
      "command": "node",
      "args": ["scripts/check-exemplars.mjs"],
      "description": "voice exemplars are unchanged against HEAD (AGENTS.md \u00a7 Prose voice)",
      "order": 1
    },
    "examples": {
      "command": "node",
      "args": ["scripts/check-example-rules.mjs"],
      "description": "blueprint ast-grep rules for every example app (docs/blueprint.md)",
      "order": 1
    },

    "dead": { "use": "fallow", "order": 2 },
    "dupes": { "use": "fallow", "order": 2 },

    "docs": { "use": "markdownlint-cli2", "order": 3 },
    "spell": { "use": "cspell", "order": 3 },
    "prose": {
      "use": "vale",
      "args": [
        "exec",
        "vale",
        "--no-global",
        "--output=JSON",
        "--glob=!**/{node_modules,dist,.runs,.trajectory,.ridgeline,.plumbbob,.check,.stryker-tmp}/**",
        "src",
        "docs",
        "test",
        "examples",
        "AGENTS.md",
        "CHANGELOG.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "README.md",
        "SECURITY.md",
        "VALUES.md"
      ],
      "exemplars": ".vale/exemplars",
      "description": "Vale: wording and copy style over markdown and TypeScript doc comments",
      "note": "vale reads no .gitignore and skips no hidden directory, so the walk is named explicitly rather than left at the adapter default of `.`. research/ is gitignored working notes and stays out, matching cspell and markdownlint.",
      "optIn": false,
      "order": 3
    },
    "test": { "use": "vitest", "order": 3 },

    "health": { "use": "fallow", "order": 4 },
    "mutation": { "use": "stryker", "optIn": true, "order": 4 },

    "build": { "use": "build", "optIn": true, "order": 10 },

    "publint": { "use": "publint", "optIn": true, "order": 20 },
    "pack": { "use": "pack", "optIn": true, "order": 20 },
    "smoke": { "use": "smoke", "optIn": true, "order": 20 },
    "snippets": { "use": "snippets-dist", "optIn": true, "order": 20 },
    "attw": {
      "use": "attw",
      "profile": "esm-only",
      "description": "Are the types wrong? (esm-only profile: this package ships ESM only)",
      "optIn": true,
      "order": 20
    },

    "security": false
  }
}
