{
  "name": "fascicle",
  "version": "0.16.3",
  "description": "Compose agents like plain values. A TypeScript toolkit that wires LLM calls, tools, and functions into typed steps over eight providers. No framework, no ambient state.",
  "keywords": [
    "agents",
    "agentic",
    "multi-agent",
    "ai",
    "llm",
    "workflow",
    "pipeline",
    "orchestration",
    "tool-calling",
    "harness",
    "streaming",
    "observability",
    "typescript",
    "composable",
    "ai-sdk",
    "vercel-ai-sdk",
    "anthropic",
    "openai",
    "gemini",
    "bedrock",
    "openrouter",
    "ollama",
    "lmstudio"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Rob McLarty",
    "email": "hello@robmclarty.com",
    "url": "https://robmclarty.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "import": "./dist/acp.js",
      "default": "./dist/acp.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "default": "./dist/adapters.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js",
      "default": "./dist/agents.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js",
      "default": "./dist/otel.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js",
      "default": "./dist/stdio.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js",
      "default": "./dist/viewer.js"
    }
  },
  "imports": {
    "#core": "./src/core/index.ts",
    "#engine": "./src/engine/index.ts",
    "#composites": "./src/composites/index.ts",
    "#adapters": "./src/adapters/index.ts",
    "#viewer": "./src/viewer/index.ts",
    "#agents": "./src/agents/index.ts",
    "#stdio": "./src/stdio/index.ts",
    "#acp": "./src/acp/index.ts",
    "#ui": "./src/ui/index.ts",
    "#policy": "./src/policy/index.ts",
    "#process": "./src/process/index.ts",
    "#schema": "./src/schema/index.ts",
    "#testing": "./src/testing/index.ts"
  },
  "bin": {
    "fascicle-viewer": "./dist/bin/fascicle-viewer.js",
    "fascicle-diagram": "./dist/bin/fascicle-diagram.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/fascicle.git"
  },
  "homepage": "https://robmclarty.github.io/fascicle/",
  "bugs": {
    "url": "https://github.com/robmclarty/fascicle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "checkride",
    "check:all": "checkride --all --skip security",
    "check:json": "checkride --json",
    "check:bail": "checkride --bail",
    "check:changed": "checkride --changed",
    "check:fix": "pnpm exec oxlint --type-aware --fix && node scripts/strip-semicolons.mjs && pnpm exec fallow fix",
    "check:mutation": "stryker run",
    "check:e2e": "playwright test",
    "check:publish": "checkride --only publint,attw,pack,smoke,snippets",
    "check:security": "checkride --only security",
    "prepublishOnly": "pnpm check && pnpm build && pnpm check:publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc --noEmit",
    "fascicle-viewer": "tsx src/viewer/cli.ts",
    "fascicle-diagram": "tsx src/diagram_bin.ts",
    "viewer:app": "vite build --config vite.viewer.config.ts",
    "viewer:app:watch": "vite build --watch --config vite.viewer.config.ts"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@ai-sdk/amazon-bedrock": "^5.0.0",
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/otel": "^1.0.0",
    "@aws-sdk/credential-providers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^7.0.0",
    "ai-sdk-ollama": "^4.0.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/amazon-bedrock": {
      "optional": true
    },
    "@aws-sdk/credential-providers": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/otel": {
      "optional": true
    },
    "@agentclientprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "ai-sdk-ollama": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@ast-grep/cli": "0.50.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@playwright/test": "1.64.0",
    "@standard-schema/spec": "1.1.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "@vvago/vale": "3.24.0",
    "ai": "7.0.138",
    "arktype": "2.2.8",
    "checkride": "0.15.0",
    "cspell": "10.3.6",
    "fallow": "3.33.1",
    "markdownlint-cli2": "0.23.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "solid-js": "1.9.17",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.4",
    "zod": "4.4.3"
  }
}
