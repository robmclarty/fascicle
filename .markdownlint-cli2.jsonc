{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    // Voice exemplars are pasted verbatim from elsewhere and are human-owned:
    // AGENTS.md tells writing sessions never to edit them, so lint findings
    // there would be unfixable by contract. They sit outside the prose walk
    // for the same reason.
    ".vale/**",
    "**/node_modules/**",
    "dist/**",
    ".check/**",
    ".stryker-tmp/**",
    ".plumbbob/**",
    ".ridgeline/**",
    "research/**",
    "spec/**",
    "examples/**/.runs/**",
    "CHANGELOG.md"
  ]
}
